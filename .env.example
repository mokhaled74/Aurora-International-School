# Copy these into your Vercel project's Environment Variables.
# None are required for the site to build; the contact form and chat
# degrade gracefully when their keys are missing.

# Inquiry form delivery (required for the contact/admissions forms to actually send)
INQUIRY_WEBHOOK_URL=

# Optional AI chat (Anthropic). Leave blank to use the built-in demo replies.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional: facts the chat assistant is allowed to use (single line).
SCHOOL_FACTS=
